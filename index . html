<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SAAD COMMUNITY – Serveur Discord</title>
<link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Nunito:wght@500;700&family=Cairo:wght@600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a1230;--bg2:#101c4a;--card:#142358;--text:#eef4ff;--muted:#a9b8e0;--cyan:#22d3ff;--blue:#1b6fe0;--gold:#f5b83d;--on:#04122e;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#eaf6ff;--bg2:#d6edff;--card:#fff;--text:#0a1a45;--muted:#43578a}}
:root[data-theme="light"]{--bg:#eaf6ff;--bg2:#d6edff;--card:#fff;--text:#0a1a45;--muted:#43578a}
:root[data-theme="dark"]{--bg:#0a1230;--bg2:#101c4a;--card:#142358;--text:#eef4ff;--muted:#a9b8e0}
html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:500 1.05rem/1.6 Nunito,system-ui,sans-serif;overflow-x:hidden}
h1,h2,h3{font-family:'Lilita One',Impact,sans-serif;font-weight:400;line-height:1.1;margin:0}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.wrap{max-width:960px;margin:0 auto;padding:0 20px}
.btn{display:inline-block;border:0;cursor:pointer;background:var(--cyan);color:var(--on);text-decoration:none;font:400 1.4rem 'Lilita One',sans-serif;padding:13px 32px;border-radius:999px;box-shadow:0 5px 0 var(--blue);transition:transform .12s,box-shadow .12s}
.btn:hover{transform:translateY(2px);box-shadow:0 3px 0 var(--blue)}
.btn.alt{background:var(--card);color:var(--text);box-shadow:0 5px 0 var(--bg2)}

/* ===== INTRO LOGO ===== */
#intro{position:fixed;inset:0;z-index:100;display:grid;place-items:center;text-align:center;cursor:pointer;
background:radial-gradient(circle at 50% 45%,#1b3a9a,#0a1230 70%);transition:opacity .6s,visibility .6s}
#intro.out{opacity:0;visibility:hidden}
#intro img{width:min(460px,82vw);height:auto;animation:drop 1.1s cubic-bezier(.2,1.5,.4,1) both,glow 2.4s ease-in-out 1.1s infinite}
#intro small{position:absolute;bottom:calc(36px + env(safe-area-inset-bottom,0px));left:0;right:0;color:#a9b8e0;animation:blink 1.6s ease-in-out infinite}
.sp{position:absolute;color:var(--gold);font-size:28px;animation:tw 1.8s ease-in-out infinite}
@keyframes drop{from{transform:translateY(-120px) scale(.6);opacity:0}to{transform:none;opacity:1}}
@keyframes glow{50%{filter:drop-shadow(0 0 28px #22d3ff)}}
@keyframes blink{50%{opacity:.35}}
@keyframes tw{0%,100%{transform:scale(.4) rotate(0);opacity:0}50%{transform:scale(1.1) rotate(25deg);opacity:1}}
@media (prefers-reduced-motion:reduce){#intro img,.sp,#intro small{animation:none}}

/* ===== SITE ===== */
.hero{text-align:center;padding:70px 0 64px;background:radial-gradient(ellipse at 50% 0,var(--bg2),var(--bg) 70%)}
.hero h1{font-size:clamp(2.4rem,9vw,4.4rem);color:var(--cyan)}
.hero p{max-width:34ch;margin:12px auto 26px;color:var(--muted);font-size:1.2rem}
section{padding:60px 0}
section.alt{background:var(--bg2)}
h2{font-size:clamp(1.9rem,6vw,2.7rem);margin-bottom:10px;color:var(--cyan)}
.sub{color:var(--muted);margin:0 0 26px;max-width:56ch}
.card{background:var(--card);border-radius:22px;padding:22px;border-bottom:5px solid var(--blue)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px}

/* Discord-like preview */
.dc{display:grid;grid-template-columns:minmax(170px,230px) 1fr;border-radius:20px;overflow:hidden;background:var(--card);border-bottom:5px solid var(--blue)}
.dc aside{background:color-mix(in srgb,var(--bg) 70%,#000);padding:14px;font-weight:700}
.dc aside h3{font-size:1.2rem;margin-bottom:10px}
.dc aside p{margin:12px 0 4px;font-size:.78rem;color:var(--muted)}
.dc aside div{padding:4px 8px;border-radius:8px;color:var(--muted)}
.dc aside .on{background:color-mix(in srgb,var(--cyan) 22%,transparent);color:var(--text)}
.dc main{padding:18px;display:flex;flex-direction:column;gap:12px}
.msg{display:flex;gap:10px}
.av{flex:none;width:38px;height:38px;border-radius:50%;display:grid;place-items:center;font:400 1.1rem 'Lilita One';color:#fff}
.msg b{font-size:.95rem}.msg p{margin:0;font-size:.95rem;color:var(--muted)}

/* roles */
.ladder{display:grid;gap:12px}
.rung{display:flex;align-items:center;gap:14px;background:var(--card);border-radius:18px;padding:14px 18px;border-inline-start:8px solid var(--c)}
.rung b{font:400 1.3rem 'Lilita One';min-width:110px;color:var(--c)}
.rung span{color:var(--muted)}

/* quiz */
.quiz{max-width:560px}
.quiz h3{font-size:1.5rem;margin-bottom:14px}
.opt{display:block;width:100%;text-align:start;margin-bottom:10px;padding:12px 16px;border-radius:14px;border:2px solid var(--blue);background:transparent;color:var(--text);font:700 1rem Nunito,sans-serif;cursor:pointer}
.opt:hover{background:color-mix(in srgb,var(--cyan) 18%,transparent)}
.res{font-size:1.6rem;color:var(--gold);margin-bottom:6px}

details{background:var(--card);border-radius:16px;padding:16px 20px;margin-bottom:12px;max-width:720px}
summary{cursor:pointer;font-weight:700}
details p{margin:10px 0 0;color:var(--muted)}
.cta{text-align:center}
.cta h2{color:var(--text)}
.cta .btn{margin:6px}
#toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,40px);background:var(--gold);color:var(--on);padding:10px 22px;border-radius:99px;font-weight:700;opacity:0;transition:.3s;z-index:50}
#toast.show{opacity:1;transform:translate(-50%,0)}
footer{padding:26px;text-align:center;color:var(--muted);font-size:.9rem}
@media (max-width:560px){.dc{grid-template-columns:1fr}.rung{flex-wrap:wrap}}

html[lang="ar"] body{font-family:Cairo,system-ui,sans-serif;line-height:1.8}
html[lang="ar"] h1,html[lang="ar"] h2,html[lang="ar"] h3,html[lang="ar"] .btn,html[lang="ar"] .lang{position:fixed;top:calc(10px + env(safe-area-inset-top,0px));right:12px;z-index:120;display:flex;gap:4px;background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:blur(6px);padding:4px;border-radius:99px}
.lang button{border:0;background:transparent;color:var(--text);font:700 .85rem Nunito,Cairo,sans-serif;padding:6px 12px;border-radius:99px;cursor:pointer}
.lang button[aria-pressed=true]{background:var(--cyan);color:var(--on)}
</style>
</head>
<body>
<div class="lang" role="group" aria-label="Langue / Language / اللغة"><button data-l="fr">FR</button><button data-l="ar">العربية</button><button data-l="en">EN</button></div>

<!-- INTRO : logo animé, se ferme seul après 3 s ou au toucher -->
<div id="intro" role="button" tabindex="0" aria-label="Entrer sur le site">
  <span class="sp" style="top:22%;left:14%">★</span><span class="sp" style="top:30%;right:12%;animation-delay:.5s">★</span>
  <span class="sp" style="bottom:28%;left:22%;animation-delay:1s">✦</span><span class="sp" style="bottom:24%;right:18%;animation-delay:.3s">✦</span>
  <img src="data:image/png;base64," alt="SAAD COMMUNITY">
  <small data-i18n="tap">Touche pour entrer</small>
</div>

<header class="hero"><div class="wrap">
  <h1 data-i18n="h1">Bienvenue dans la communauté</h1>
  <p data-i18n="hp">Discute, joue et gagne ta place parmi les membres de SAAD COMMUNITY.</p>
  <a class="btn" href="https://discord.gg/6WCYukkHJ" target="_blank" rel="noopener" data-i18n="join">Rejoindre le serveur</a>
  </div></header>

<main>
<section class="alt"><div class="wrap">
  <h2 data-i18n="peek">Jette un œil à l'intérieur</h2>
  <p class="sub" data-i18n="peeksub">Voilà à quoi ressemble le serveur une fois dedans. Remplace les salons par les tiens.</p>
  <div class="dc">
    <aside>
      <h3>SAAD COMMUNITY</h3>
      <p data-i18n="c1">INFOS</p><div># bienvenue</div><div># règles</div><div># annonces</div>
      <p data-i18n="c2">DISCUSSION</p><div class="on"># général</div><div># mèmes</div>
      <p data-i18n="c3">VOCAL</p><div>🔊 Salon 1</div><div>🔊 Salon 2</div>
    </aside>
    <main>
      <div class="msg"><div class="av" style="background:#1b6fe0">S</div><div><b>Saad</b><p data-i18n="m1">Bienvenue à tous ! Soirée jeux samedi à 20h 🎮</p></div></div>
      <div class="msg"><div class="av" style="background:#f5b83d;color:#04122e">N</div><div><b data-i18n="newm">Nouveau membre</b><p data-i18n="m2">Merci pour l'accueil, je suis chaud !</p></div></div>
      <div class="msg"><div class="av" style="background:#22a96b">M</div><div><b data-i18n="mod">Modérateur</b><p data-i18n="m3">Passez dans le vocal, on forme les équipes.</p></div></div>
    </main>
  </div>
</div></section>

<section><div class="wrap">
  <h2 data-i18n="rank">Monte en grade</h2>
  <p class="sub" data-i18n="ranksub">Plus tu participes, plus tu débloques de rôles.</p>
  <div class="ladder">
    <div class="rung" style="--c:#a9b8e0"><b data-i18n="r1n">Nouveau</b><span data-i18n="r1d">Tu viens d'arriver. Présente-toi dans le salon général.</span></div>
    <div class="rung" style="--c:#22d3ff"><b data-i18n="r2n">Actif</b><span data-i18n="r2d">Tu discutes et joues régulièrement avec nous.</span></div>
    <div class="rung" style="--c:#f5b83d"><b data-i18n="r3n">VIP</b><span data-i18n="r3d">Tu aides les autres et participes aux événements.</span></div>
    <div class="rung" style="--c:#ff6b8a"><b data-i18n="mod">Modérateur</b><span data-i18n="r4d">Tu fais partie de l'équipe qui veille sur le serveur.</span></div>
  </div>
</div></section>

<section class="alt"><div class="wrap">
  <h2 data-i18n="quizh">Quel membre es-tu ?</h2>
  <p class="sub" data-i18n="quizsub">Trois questions, un résultat.</p>
  <div class="card quiz" id="quiz"></div>
</div></section>

<section><div class="wrap">
  <h2 data-i18n="faq">Questions fréquentes</h2>
  <details><summary data-i18n="f1q">Comment rejoindre ?</summary><p data-i18n="f1a">Clique sur « Rejoindre le serveur » et accepte l'invitation dans Discord.</p></details>
  <details><summary data-i18n="f2q">C'est gratuit ?</summary><p data-i18n="f2a">Oui, totalement.</p></details>
  <details><summary data-i18n="f3q">Comment devenir modérateur ?</summary><p data-i18n="f3a">Sois actif et respectueux, puis écris à un membre de l'équipe en message privé.</p></details>
</div></section>

<section class="alt cta"><div class="wrap">
  <h2 data-i18n="cta">Ta place t'attend</h2>
  <a class="btn" href="https://discord.gg/6WCYukkHJ" target="_blank" rel="noopener" data-i18n="open">Ouvrir Discord</a>
  <button class="btn alt" id="copy" data-i18n="copy">Copier le lien</button>
</div></section>
</main>
<footer>© SAAD COMMUNITY</footer>
<div id="toast" role="status" data-i18n="toast">Lien copié !</div>

<script>
const LINK="https://discord.gg/6WCYukkHJ";
// --- intro ---
const intro=document.getElementById("intro");
function closeIntro(){intro.classList.add("out")}
intro.addEventListener("click",closeIntro);
intro.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" ")closeIntro()});
setTimeout(closeIntro,3200);
// --- traduction FR / AR / EN ---
let lang="fr";
const L={fr:{},
en:{tap:"Tap to enter",h1:"Welcome to the community",hp:"Chat, play and earn your place among the members of SAAD COMMUNITY.",join:"Join the server",peek:"Take a look inside",peeksub:"This is what the server looks like once you're in. Replace the channels with your own.",c1:"INFO",c2:"CHAT",c3:"VOICE",m1:"Welcome everyone! Game night on Saturday at 8 PM 🎮",m2:"Thanks for the welcome, I'm ready!",m3:"Jump in the voice channel, we're forming teams.",newm:"New member",mod:"Moderator",rank:"Level up",ranksub:"The more you take part, the more roles you unlock.",r1n:"Newcomer",r2n:"Active",r3n:"VIP",r1d:"You just arrived. Introduce yourself in the general channel.",r2d:"You chat and play with us regularly.",r3d:"You help others and join events.",r4d:"You're part of the team watching over the server.",quizh:"Which member are you?",quizsub:"Three questions, one result.",faq:"Frequently asked questions",f1q:"How do I join?",f1a:"Click “Join the server” and accept the invite in Discord.",f2q:"Is it free?",f2a:"Yes, completely.",f3q:"How do I become a moderator?",f3a:"Be active and respectful, then message a team member privately.",cta:"Your spot is waiting",open:"Open Discord",copy:"Copy link",toast:"Link copied!"},
ar:{tap:"المس للدخول",h1:"مرحباً بك في المجتمع",hp:"تحدّث والعب واصنع مكانتك بين أعضاء SAAD COMMUNITY.",join:"انضم إلى السيرفر",peek:"ألقِ نظرة من الداخل",peeksub:"هكذا يبدو السيرفر بعد أن تنضم إليه. استبدل القنوات بقنواتك.",c1:"معلومات",c2:"نقاش",c3:"صوتي",m1:"أهلاً بالجميع! سهرة ألعاب السبت الساعة 8 مساءً 🎮",m2:"شكراً على الترحيب، أنا جاهز!",m3:"تعالوا إلى الصوتي، سنكوّن الفرق.",newm:"عضو جديد",mod:"مشرف",rank:"ارتقِ في الرتب",ranksub:"كلما شاركت أكثر، فتحت رتباً أكثر.",r1n:"جديد",r2n:"نشيط",r3n:"VIP",r1d:"وصلت للتو. عرّف بنفسك في القناة العامة.",r2d:"تتحدث وتلعب معنا بانتظام.",r3d:"تساعد الآخرين وتشارك في الفعاليات.",r4d:"أنت من الفريق الذي يسهر على السيرفر.",quizh:"أي عضو أنت؟",quizsub:"ثلاثة أسئلة ونتيجة واحدة.",faq:"الأسئلة الشائعة",f1q:"كيف أنضم؟",f1a:"اضغط على «انضم إلى السيرفر» ووافق على الدعوة داخل Discord.",f2q:"هل هو مجاني؟",f2a:"نعم، مجاني تماماً.",f3q:"كيف أصبح مشرفاً؟",f3a:"كن نشيطاً ومحترماً، ثم راسل أحد أعضاء الفريق برسالة خاصة.",cta:"مكانك ينتظرك",open:"افتح Discord",copy:"انسخ الرابط",toast:"تم نسخ الرابط!"}};
const QZ={
fr:{q:["Un samedi soir, tu fais quoi ?","Dans le serveur, tu es plutôt…","Ton super-pouvoir ?"],a:[["Je lance une partie en vocal","Je discute avec tout le monde","J'organise une équipe"],["Toujours en vocal","Dans les salons texte","À proposer des idées"],["Ne jamais perdre","Faire rire tout le monde","Tout planifier"]],r:{j:["Le Joueur","Toujours prêt pour une partie. Retrouve les autres dans les salons vocaux."],b:["Le Bavard","L'ambiance du serveur, c'est toi. Passe dans le salon général."],s:["Le Stratège","Tu as le profil pour organiser des événements. Parle-en à l'équipe !"]},again:"Recommencer"},
en:{q:["What do you do on a Saturday night?","In the server, you're more of a…","Your superpower?"],a:[["Start a game in voice chat","Chat with everyone","Organize a team"],["Always in voice","In the text channels","Coming up with ideas"],["Never losing","Making everyone laugh","Planning everything"]],r:{j:["The Player","Always ready for a match. Find the others in the voice channels."],b:["The Chatterbox","You are the server's vibe. Drop by the general channel."],s:["The Strategist","You have what it takes to organize events. Talk to the team!"]},again:"Start over"},
ar:{q:["ماذا تفعل مساء السبت؟","في السيرفر، أنت أقرب إلى…","قدرتك الخارقة؟","" ].slice(0,3),a:[["أبدأ لعبة في الصوتي","أتحدث مع الجميع","أنظّم فريقاً"],["دائماً في الصوتي","في قنوات الكتابة","أقترح الأفكار"],["لا أخسر أبداً","أُضحك الجميع","أخطّط لكل شيء"]],r:{j:["اللاعب","جاهز دائماً للعب. ستجد الآخرين في القنوات الصوتية."],b:["الثرثار","أنت روح السيرفر. مرّ بالقناة العامة."],s:["المخطّط","لديك ما يلزم لتنظيم الفعاليات. حدّث الفريق!"]},again:"أعد من جديد"}};
function applyLang(l){
  lang=l;const d=document.documentElement;d.lang=l;d.dir=l==="ar"?"rtl":"ltr";
  document.querySelectorAll("[data-i18n]").forEach(el=>{const k=el.dataset.i18n;if(L.fr[k]===undefined)L.fr[k]=el.textContent;el.textContent=L[l][k]??L.fr[k]});
  document.querySelectorAll(".lang button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.l===l));
  try{localStorage.setItem("saad-lang",l)}catch(e){}
  show();
}
// capture FR text before first switch
document.querySelectorAll("[data-i18n]").forEach(el=>{L.fr[el.dataset.i18n]=el.textContent});
document.querySelectorAll(".lang button").forEach(b=>b.onclick=()=>applyLang(b.dataset.l));
// --- quiz ---
const KEYS=["j","b","s"];let i=0,sc={j:0,b:0,s:0};const box=document.getElementById("quiz");
function show(){const Z=QZ[lang];
 if(i>=Z.q.length){const k=Object.keys(sc).sort((x,y)=>sc[y]-sc[x])[0];
  box.innerHTML=`<div class="res">${Z.r[k][0]}</div><p>${Z.r[k][1]}</p><button class="btn" id="again">${Z.again}</button>`;
  document.getElementById("again").onclick=()=>{i=0;sc={j:0,b:0,s:0};show()};return}
 box.innerHTML=`<h3>${Z.q[i]}</h3>`+Z.a[i].map((t,n)=>`<button class="opt" data-k="${KEYS[n]}">${t}</button>`).join("");
 box.querySelectorAll(".opt").forEach(b=>b.onclick=()=>{sc[b.dataset.k]++;i++;show()})}
// --- copier le lien ---
document.getElementById("copy").onclick=async()=>{
 try{await navigator.clipboard.writeText(LINK)}catch(e){const t=document.createElement("textarea");t.value=LINK;document.body.appendChild(t);t.select();try{document.execCommand("copy")}catch(_){}t.remove()}
 const el=document.getElementById("toast");el.classList.add("show");setTimeout(()=>el.classList.remove("show"),1800)};

// langue initiale : choix sauvegardé, sinon langue du navigateur
let saved=null;try{saved=localStorage.getItem("saad-lang")}catch(e){}
const nav=(navigator.language||"fr").slice(0,2);
applyLang(saved||(["ar","en"].includes(nav)?nav:"fr"));
</script>
</body>
</html>
